# Copia este archivo a .env (cp .env.example .env) y cambia el valor. .env nunca se versiona.
# Dirección del servidor de WEather vista desde el móvil:
#   - Móvil real con Expo Go: la IP del ordenador en la wifi, p. ej. http://192.168.1.20:8080
#   - Emulador de Android: http://10.0.2.2:8080
#   - Simulador de iOS: http://localhost:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
