<?xml version="1.0" encoding="UTF-8"?>
<!-- Patrones de SpotBugs que no se comprueban en el backend. Cada exclusión explica su motivo. -->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!-- EI_EXPOSE_REP2: avisa cuando un constructor guarda un objeto mutable que recibe. Con la
        inyección por constructor de Spring (JdbcTemplate, JsonMapper...) es un falso positivo:
        esos beans son compartidos a propósito y no se copian. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
